CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE USERS(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,FULL_NAME VARCHAR(100) NOT NULL,PHONE VARCHAR(30) NOT NULL,USERNAME VARCHAR(50) NOT NULL,EMAIL VARCHAR(150) DEFAULT '',PASSWORD_SALT VARCHAR(100) NOT NULL,PASSWORD_HASH VARCHAR(150) NOT NULL,ROLE VARCHAR(15) NOT NULL,CREATED_AT VARCHAR(40) DEFAULT '',CONSTRAINT SYS_CT_47 UNIQUE(USERNAME))
CREATE MEMORY TABLE SHOPS(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,NAME VARCHAR(100) NOT NULL,CATEGORY VARCHAR(40) NOT NULL,DESCRIPTION VARCHAR(500) DEFAULT '',ACTIVE INTEGER DEFAULT 1)
CREATE MEMORY TABLE PRODUCTS(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,SHOP_ID INTEGER NOT NULL,SECTION VARCHAR(100) NOT NULL,NAME VARCHAR(150) NOT NULL,PRICE DECIMAL(14,2) NOT NULL,STOCK INTEGER NOT NULL,ACTIVE INTEGER DEFAULT 1,DESCRIPTION VARCHAR(600) DEFAULT '',IMAGE_URL VARCHAR(600) DEFAULT '',CONSTRAINT SYS_FK_53 FOREIGN KEY(SHOP_ID) REFERENCES SHOPS(ID))
CREATE MEMORY TABLE PRODUCT_SPECS(PRODUCT_ID INTEGER NOT NULL,SPEC_KEY VARCHAR(100) NOT NULL,SPEC_VALUE VARCHAR(250) NOT NULL,PRIMARY KEY(PRODUCT_ID,SPEC_KEY),CONSTRAINT SYS_FK_58 FOREIGN KEY(PRODUCT_ID) REFERENCES PRODUCTS(ID))
CREATE MEMORY TABLE ORDERS(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,USER_ID INTEGER NOT NULL,CREATED_AT VARCHAR(40) NOT NULL,SUBTOTAL DECIMAL(14,2) NOT NULL,GST DECIMAL(14,2) NOT NULL,TOTAL DECIMAL(14,2) NOT NULL,STATUS VARCHAR(20) NOT NULL,DELIVERY_NAME VARCHAR(100) NOT NULL,DELIVERY_PHONE VARCHAR(30) NOT NULL,DELIVERY_ADDRESS VARCHAR(500) NOT NULL,NOTES VARCHAR(500) DEFAULT '',CONSTRAINT SYS_FK_63 FOREIGN KEY(USER_ID) REFERENCES USERS(ID))
CREATE MEMORY TABLE ORDER_ITEMS(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,ORDER_ID INTEGER NOT NULL,PRODUCT_ID INTEGER NOT NULL,NAME_SNAPSHOT VARCHAR(150) NOT NULL,QTY INTEGER NOT NULL,UNIT_PRICE DECIMAL(14,2) NOT NULL,TAX_RATE DECIMAL(5,2) NOT NULL,CONSTRAINT SYS_FK_68 FOREIGN KEY(ORDER_ID) REFERENCES ORDERS(ID),CONSTRAINT SYS_FK_69 FOREIGN KEY(PRODUCT_ID) REFERENCES PRODUCTS(ID))
CREATE MEMORY TABLE MOVIES(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,TITLE VARCHAR(150) NOT NULL,DIRECTOR VARCHAR(100) DEFAULT '',GENRE VARCHAR(80) DEFAULT '',DURATION_MIN INTEGER DEFAULT 120,ACTIVE INTEGER DEFAULT 1)
CREATE MEMORY TABLE SHOWS(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,MOVIE_ID INTEGER NOT NULL,SCREEN_NO INTEGER NOT NULL,SHOW_TIME VARCHAR(50) NOT NULL,TOTAL_SEATS INTEGER NOT NULL,BOOKED_SEATS INTEGER DEFAULT 0,PRICE DECIMAL(14,2) NOT NULL,ACTIVE INTEGER DEFAULT 1,CONSTRAINT SYS_FK_78 FOREIGN KEY(MOVIE_ID) REFERENCES MOVIES(ID))
CREATE MEMORY TABLE BOOKINGS(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,USER_ID INTEGER NOT NULL,SHOW_ID INTEGER NOT NULL,TICKETS INTEGER NOT NULL,TOTAL DECIMAL(14,2) NOT NULL,STATUS VARCHAR(20) NOT NULL,CREATED_AT VARCHAR(40) NOT NULL,CONSTRAINT SYS_FK_83 FOREIGN KEY(USER_ID) REFERENCES USERS(ID),CONSTRAINT SYS_FK_84 FOREIGN KEY(SHOW_ID) REFERENCES SHOWS(ID))
CREATE MEMORY TABLE SETTINGS(KEY VARCHAR(80) NOT NULL PRIMARY KEY,VALUE VARCHAR(500) NOT NULL)
ALTER TABLE USERS ALTER COLUMN ID RESTART WITH 3
ALTER TABLE SHOPS ALTER COLUMN ID RESTART WITH 8
ALTER TABLE PRODUCTS ALTER COLUMN ID RESTART WITH 51
ALTER TABLE ORDERS ALTER COLUMN ID RESTART WITH 1
ALTER TABLE ORDER_ITEMS ALTER COLUMN ID RESTART WITH 3
ALTER TABLE MOVIES ALTER COLUMN ID RESTART WITH 6
ALTER TABLE SHOWS ALTER COLUMN ID RESTART WITH 6
ALTER TABLE BOOKINGS ALTER COLUMN ID RESTART WITH 0
CREATE USER SA PASSWORD ""
GRANT DBA TO SA
SET WRITE_DELAY 10
SET SCHEMA PUBLIC
